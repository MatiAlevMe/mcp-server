# MCP Server Configuration
# Copy this file to .env and adjust values for your project

# Server Identity
MCP_SERVER_NAME=my-custom-mcp
MCP_SERVER_VERSION=1.0.0
MCP_SERVER_DESCRIPTION=Custom MCP Server for My project

# MySQL Database (set ENABLE_MYSQL=true to enable)
ENABLE_MYSQL=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=my_database

# Git Tools (set ENABLE_GIT=true to enable)
ENABLE_GIT=false